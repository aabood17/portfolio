---
import type { GetStaticPaths } from "astro";
import { getCollection, render } from "astro:content";
import { Image } from "astro:assets";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Icon from "../../components/Icon.astro";
import { site } from "../../data/site";

export const getStaticPaths = (async () => {
  const projects = (await getCollection("projects")).sort((a, b) => a.data.order - b.data.order);
  return projects.map((project, i) => ({
    params: { slug: project.id },
    props: { project, next: projects[(i + 1) % projects.length] },
  }));
}) satisfies GetStaticPaths;

const { project, next } = Astro.props;
const { title, tagline, summary, role, context, stack, cover, coverAlt, gallery, repo, live } = project.data;
const { Content } = await render(project);
---

<BaseLayout title={`${title} | ${site.name}`} description={summary}>
  <article class="mx-auto max-w-4xl px-4 py-12 sm:px-6 sm:py-16">
    <a href="/#projects" class="text-muted hover:text-accent inline-flex items-center gap-2 text-sm font-medium">
      <Icon name="arrowLeft" class="size-4" />
      All projects
    </a>

    <header class="mt-8">
      <p class="text-accent font-mono text-sm">{context}</p>
      <h1 class="mt-2 text-4xl font-bold tracking-tight sm:text-5xl">{title}</h1>
      <p class="text-muted mt-3 text-xl">{tagline}</p>

      <div class="mt-6 flex flex-wrap gap-3">
        {repo && (
          <a
            href={repo}
            target="_blank"
            rel="noopener noreferrer"
            class="bg-accent text-accent-fg hover:bg-accent-hover inline-flex items-center gap-2 rounded-md px-4 py-2.5 text-sm font-semibold"
          >
            <Icon name="github" class="size-4" />
            View code
          </a>
        )}
        {live && (
          <a
            href={live}
            target="_blank"
            rel="noopener noreferrer"
            class="border-border hover:border-accent inline-flex items-center gap-2 rounded-md border px-4 py-2.5 text-sm font-semibold"
          >
            Live demo
            <Icon name="arrowUpRight" class="size-4" />
          </a>
        )}
      </div>
    </header>

    <dl class="border-border bg-surface mt-10 grid gap-px overflow-hidden rounded-xl border sm:grid-cols-2">
      <div class="p-5">
        <dt class="text-muted font-mono text-xs tracking-wide uppercase">My role</dt>
        <dd class="mt-1.5 font-medium">{role}</dd>
      </div>
      <div class="border-border border-t p-5 sm:border-t-0 sm:border-l">
        <dt class="text-muted font-mono text-xs tracking-wide uppercase">Tech stack</dt>
        <dd class="mt-2">
          <ul class="flex flex-wrap gap-1.5">
            {stack.map((tech) => (
              <li class="bg-accent-soft rounded px-2 py-0.5 font-mono text-xs">{tech}</li>
            ))}
          </ul>
        </dd>
      </div>
    </dl>

    {cover && (
      <figure class="border-border bg-accent-soft mt-10 overflow-hidden rounded-xl border">
        <Image
          src={cover}
          alt={coverAlt ?? ""}
          width={1200}
          class="mx-auto max-h-[36rem] w-auto object-contain p-4 sm:p-8"
          loading="eager"
        />
      </figure>
    )}

    <div class="prose-content mt-12">
      <Content />
    </div>

    {gallery.length > 0 && (
      <div class="mt-12 grid gap-6 sm:grid-cols-2">
        {gallery.map((item) => (
          <figure class="border-border bg-accent-soft overflow-hidden rounded-xl border">
            <Image src={item.src} alt={item.alt} width={700} class="mx-auto max-h-[32rem] w-auto object-contain p-4" />
          </figure>
        ))}
      </div>
    )}

    <footer class="border-border mt-16 flex flex-col gap-6 border-t pt-8 sm:flex-row sm:items-center sm:justify-between">
      <a href={`/projects/${next.id}/`} class="group">
        <span class="text-muted font-mono text-xs uppercase">Next project</span>
        <span class="group-hover:text-accent mt-1 flex items-center gap-2 text-lg font-bold">
          {next.data.title}
          <Icon name="arrowRight" class="size-4 transition-transform group-hover:translate-x-0.5" />
        </span>
      </a>
      <a
        href="/#contact"
        class="bg-accent text-accent-fg hover:bg-accent-hover inline-flex items-center justify-center gap-2 rounded-md px-5 py-3 text-sm font-semibold"
      >
        Get in touch
      </a>
    </footer>
  </article>
</BaseLayout>
