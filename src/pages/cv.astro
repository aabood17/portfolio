---
// Printable CV, same content as Abdullah's CV (src/data/cv.ts) without the phone number.
// `npm run cv` prints this page to public/cv.pdf.
import "@fontsource-variable/inter";
import { cv } from "../data/cv";
import { site, socials } from "../data/site";

const link = (id: string) => socials.find((s) => s.id === id)!;
const siteHost = Astro.site?.host ?? "";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>{site.name} | CV</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <main class="cv">
      <header>
        <h1>{site.name}</h1>
        <p class="role">{site.role}</p>
        <p class="contact">
          <span>{site.location}</span>
          <span>{site.email}</span>
          <a href={Astro.site?.href}>{siteHost}</a>
          <a href={link("linkedin").href}>LinkedIn</a>
          <a href={link("github").href}>GitHub</a>
        </p>
      </header>

      <section>
        <h2>Summary</h2>
        <p>{cv.summary}</p>
      </section>

      <section>
        <h2>Education</h2>
        {cv.education.map((entry) => (
          <div class="item">
            <div class="row">
              <p>
                <strong>{entry.title}</strong> — {entry.subtitle}
              </p>
              <p class="date">{entry.period}</p>
            </div>
            {entry.bullets.map((line) => (
              <p>{line}</p>
            ))}
          </div>
        ))}
      </section>

      <section>
        <h2>Technical skills</h2>
        <ul class="skills">
          {cv.skills.map((skill) => (
            <li>
              <strong>{skill.label}:</strong> {skill.value}
            </li>
          ))}
        </ul>
      </section>

      <section>
        <h2>Experience</h2>
        {cv.experience.map((entry) => (
          <div class="item">
            <div class="row">
              <p>
                <strong>{entry.title}</strong> — {entry.subtitle}
              </p>
              <p class="date">{entry.period}</p>
            </div>
            <ul>
              {entry.bullets.map((line) => (
                <li>{line}</li>
              ))}
              {entry.link && (
                <li>
                  Code: <a href={entry.link.href}>{entry.link.label}</a>
                </li>
              )}
            </ul>
          </div>
        ))}
      </section>

      <section>
        <h2>Projects</h2>
        {cv.projects.map((entry) => (
          <div class="item">
            <div class="row">
              <p>
                <strong>{entry.title}</strong>
              </p>
              {entry.period && <p class="date">{entry.period}</p>}
            </div>
            <ul>
              {entry.bullets.map((line) => (
                <li>{line}</li>
              ))}
              {entry.link && (
                <li>
                  Code: <a href={entry.link.href}>{entry.link.label}</a>
                </li>
              )}
            </ul>
          </div>
        ))}
      </section>

      <section>
        <h2>Certifications & training</h2>
        <ul>
          {cv.certifications.map((cert) => (
            <li>
              {cert.text}
              {cert.link && (
                <>
                  {" — "}
                  <a href={cert.link.href}>{cert.link.label}</a>
                </>
              )}
            </li>
          ))}
        </ul>
      </section>

      <section>
        <h2>Languages</h2>
        <p>{cv.languages}</p>
      </section>

      <section>
        <h2>Voluntary experience</h2>
        <ul>
          {cv.volunteering.map((line) => (
            <li>{line}</li>
          ))}
        </ul>
      </section>
    </main>
  </body>
</html>

<style is:global>
  @page {
    size: A4;
    margin: 14mm 16mm;
  }
  html {
    background: #e7e5e4;
  }
  body {
    margin: 0;
    font-family: "Inter Variable", system-ui, sans-serif;
    font-size: 9.6pt;
    line-height: 1.45;
    color: #1c1917;
  }
  .cv {
    box-sizing: border-box;
    max-width: 210mm;
    margin: 24px auto;
    padding: 14mm 16mm;
    background: #fff;
    box-shadow: 0 1px 3px rgb(0 0 0 / 0.15);
  }
  @media print {
    html {
      background: #fff;
    }
    .cv {
      margin: 0;
      padding: 0;
      box-shadow: none;
    }
  }
  a {
    color: #1e3a5f;
  }
  p {
    margin: 0;
  }
  header {
    text-align: center;
    padding-bottom: 10px;
    border-bottom: 1.5px solid #1e3a5f;
  }
  h1 {
    margin: 0;
    color: #1e3a5f;
    font-size: 22pt;
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }
  .role {
    color: #57534e;
    font-size: 12pt;
    font-style: italic;
  }
  .contact {
    margin-top: 4px;
    color: #57534e;
    font-size: 9pt;
  }
  .contact > * + *::before {
    content: "|";
    display: inline-block;
    margin: 0 8px;
    color: #a8a29e;
  }
  section {
    margin-top: 12px;
  }
  h2 {
    margin: 0 0 6px;
    padding-bottom: 2px;
    border-bottom: 1px solid #d6d3d1;
    color: #1e3a5f;
    font-size: 10.5pt;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .item {
    break-inside: avoid;
  }
  .item + .item {
    margin-top: 8px;
  }
  .row {
    display: flex;
    justify-content: space-between;
    gap: 16px;
  }
  .date {
    color: #57534e;
    font-style: italic;
    white-space: nowrap;
  }
  ul {
    margin: 3px 0 0;
    padding-left: 18px;
  }
  li + li {
    margin-top: 2px;
  }
  .skills {
    padding-left: 0;
    list-style: none;
  }
</style>
