---
import BaseLayout from "../layouts/BaseLayout.astro";
import Icon from "../components/Icon.astro";
import { site } from "../data/site";
---

<BaseLayout title={`Page not found | ${site.name}`} description="This page doesn't exist.">
  <section class="mx-auto flex max-w-xl flex-col items-center px-4 py-24 text-center sm:py-32">
    <p class="text-accent font-mono text-sm">404</p>
    <h1 class="mt-3 text-4xl font-bold tracking-tight">Page not found</h1>
    <p class="text-muted mt-4 text-lg">The page you're looking for doesn't exist or has moved.</p>
    <a
      href="/"
      class="bg-accent text-accent-fg hover:bg-accent-hover mt-8 inline-flex items-center gap-2 rounded-md px-5 py-3 text-sm font-semibold"
    >
      <Icon name="arrowLeft" class="size-4" />
      Back to home
    </a>
  </section>
</BaseLayout>
