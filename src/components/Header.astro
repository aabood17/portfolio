---
import Icon from "./Icon.astro";
import { nav, site } from "../data/site";
---

<header class="border-border/70 bg-bg/80 sticky top-0 z-40 border-b backdrop-blur-md">
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between gap-4 px-4 sm:px-6">
    <a href="/" class="group flex items-center gap-2.5">
      <span
        class="bg-ink text-ink-fg font-arabic grid size-10 place-items-center rounded-xl pb-1.5 text-2xl leading-none font-bold transition-transform group-hover:-rotate-6"
        lang="ar"
        aria-hidden="true"
      >
        ع
      </span>
      <span class="font-display text-lg font-semibold tracking-tight">aburiala</span>
      <span class="sr-only">, {site.name} home</span>
    </a>

    <nav aria-label="Main" class="hidden md:block">
      <ul class="flex items-center gap-1">
        {nav.map((item) => (
          <li>
            <a
              href={item.href}
              class="text-muted hover:text-text hover:bg-accent-soft rounded-full px-4 py-2 text-sm font-medium transition-colors"
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="flex items-center gap-2">
      <button
        type="button"
        data-theme-toggle
        class="text-muted hover:text-text hover:bg-accent-soft grid size-10 place-items-center rounded-full transition-colors"
        aria-label="Toggle dark mode"
      >
        <Icon name="moon" class="size-5 dark:hidden" />
        <Icon name="sun" class="hidden size-5 dark:block" />
      </button>
      <a
        href={site.cvPath}
        download="Abdullah-Abu-Riala-CV.pdf"
        class="bg-ink text-ink-fg hidden items-center gap-2 rounded-full px-4 py-2 text-sm font-semibold transition-transform hover:-translate-y-0.5 sm:inline-flex"
      >
        <Icon name="download" class="size-4" />
        CV
      </a>
      <button
        type="button"
        data-menu-toggle
        class="text-muted hover:text-text hover:bg-accent-soft grid size-10 place-items-center rounded-full md:hidden"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <Icon name="menu" class="size-5" />
      </button>
    </div>
  </div>

  <nav id="mobile-menu" aria-label="Mobile" class="border-border hidden border-t md:hidden">
    <ul class="mx-auto max-w-6xl px-4 py-2">
      {nav.map((item) => (
        <li>
          <a href={item.href} class="hover:bg-accent-soft block rounded-md px-3 py-3 text-base font-medium">
            {item.label}
          </a>
        </li>
      ))}
      <li>
        <a
          href={site.cvPath}
          download="Abdullah-Abu-Riala-CV.pdf"
          class="text-accent hover:bg-accent-soft flex items-center gap-2 rounded-md px-3 py-3 text-base font-medium"
        >
          <Icon name="download" class="size-4" />
          Download CV
        </a>
      </li>
    </ul>
  </nav>
</header>

<script>
  const themeButton = document.querySelector<HTMLButtonElement>("[data-theme-toggle]");
  themeButton?.addEventListener("click", () => {
    const dark = document.documentElement.classList.toggle("dark");
    try {
      localStorage.setItem("theme", dark ? "dark" : "light");
    } catch {
      // Storage can be blocked; the toggle still works for this visit.
    }
  });

  const menuButton = document.querySelector<HTMLButtonElement>("[data-menu-toggle]");
  const menu = document.getElementById("mobile-menu");
  const setMenu = (open: boolean) => {
    menu?.classList.toggle("hidden", !open);
    menuButton?.setAttribute("aria-expanded", String(open));
    menuButton?.setAttribute("aria-label", open ? "Close menu" : "Open menu");
  };
  menuButton?.addEventListener("click", () => setMenu(menu?.classList.contains("hidden") ?? false));
  menu?.querySelectorAll("a").forEach((link) => link.addEventListener("click", () => setMenu(false)));
  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape") setMenu(false);
  });
</script>
