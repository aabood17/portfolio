---
interface Props {
  id: string;
  index: string;
  title: string;
  intro?: string;
  class?: string;
}

const { id, index, title, intro, class: className } = Astro.props;
---

<section id={id} aria-labelledby={`${id}-title`} class:list={["border-border border-t", className]}>
  <div class="mx-auto max-w-6xl px-4 py-20 sm:px-6 sm:py-28">
    <div class="mb-12 flex max-w-3xl flex-col gap-4 sm:mb-14" data-reveal>
      <p class="text-clay font-mono text-sm font-semibold tracking-widest">{index}</p>
      <h2 id={`${id}-title`} class="font-display text-4xl leading-none font-extrabold tracking-[-0.03em] sm:text-6xl">
        {title}
      </h2>
      {intro && <p class="text-muted text-lg leading-relaxed text-pretty">{intro}</p>}
    </div>
    <slot />
  </div>
</section>
