---
// Decorative band of Palestinian cross-stitch (tatreez) motifs between sections.
const id = `tatreez-${Math.random().toString(36).slice(2, 8)}`;
---

<div class="h-7 bg-[#1b1c17]" aria-hidden="true">
  <svg class="h-7 w-full" preserveAspectRatio="none">
    <defs>
      <pattern id={id} width="40" height="28" patternUnits="userSpaceOnUse">
        <path
          d="M8 6l6 6M14 6l-6 6M20 14l6 6M26 14l-6 6M32 6l6 6M38 6l-6 6M14 16l6 6M20 16l-6 6"
          class="stroke-clay"
          stroke-width="2.2"
          stroke-linecap="round"
          fill="none"
        ></path>
      </pattern>
    </defs>
    <rect width="100%" height="28" fill={`url(#${id})`}></rect>
  </svg>
</div>
