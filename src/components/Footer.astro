---
import SocialLinks from "./SocialLinks.astro";
import Tatreez from "./Tatreez.astro";
import { site } from "../data/site";

const year = new Date().getFullYear();
---

<footer>
  <Tatreez />
  <div class="mx-auto flex max-w-6xl flex-col items-center justify-between gap-4 px-4 py-8 sm:flex-row sm:px-6">
    <p class="text-muted text-sm">
      © {year} {site.name} · Made in Bethlehem
      <span class="font-arabic" lang="ar">
        · صُنع في بيت لحم
      </span>
    </p>
    <SocialLinks />
  </div>
</footer>
